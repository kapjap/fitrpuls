<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/welcome_ink"
    android:fillViewport="true"
    android:clipToPadding="true"
    android:scrollbars="none">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout
            android:id="@+id/welcomeContent"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp" android:paddingEnd="24dp"
            android:paddingTop="24dp" android:paddingBottom="24dp"
            app:layout_constraintWidth_max="560dp"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="0.5">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:text="@string/welcome_edition" android:textAppearance="@style/WelcomeMicro"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" android:text="@string/welcome_index" android:textAppearance="@style/WelcomeMicro"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="16dp" android:background="@color/welcome_rule" android:importantForAccessibility="no"/>

            <!-- The brand is a typographic poster, read as one name by TalkBack. -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/welcomePoster" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:layout_marginBottom="24dp"
                android:contentDescription="@string/ag_brand" android:importantForAccessibility="yes" android:focusable="true">
                <androidx.appcompat.widget.AppCompatTextView android:id="@+id/welcomeAnti"
                    android:layout_width="0dp" android:layout_height="116dp"
                    android:fontFamily="sans-serif-condensed" android:textStyle="bold"
                    android:includeFontPadding="false" android:gravity="start|center_vertical"
                    android:text="@string/welcome_anti" android:textColor="@color/welcome_paper"
                    android:importantForAccessibility="no" android:maxLines="1"
                    app:autoSizeTextType="uniform" app:autoSizeMinTextSize="48sp" app:autoSizeMaxTextSize="128sp" app:autoSizeStepGranularity="1sp"
                    app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@id/welcomeTicket"
                    app:layout_constraintTop_toTopOf="parent" android:layout_marginEnd="12dp"/>
                <ImageView android:id="@+id/welcomeTicket" android:layout_width="32dp" android:layout_height="176dp"
                    android:src="@drawable/welcome_ticket" android:contentDescription="@null" android:importantForAccessibility="no"
                    app:layout_constraintTop_toTopOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
                <androidx.appcompat.widget.AppCompatTextView android:id="@+id/welcomeGym"
                    android:layout_width="0dp" android:layout_height="116dp" android:layout_marginStart="40dp" android:layout_marginEnd="40dp"
                    android:fontFamily="sans-serif-condensed" android:textStyle="bold"
                    android:includeFontPadding="false" android:gravity="end|center_vertical"
                    android:text="@string/welcome_gym" android:textColor="@color/welcome_paper"
                    android:importantForAccessibility="no" android:maxLines="1"
                    app:autoSizeTextType="uniform" app:autoSizeMinTextSize="48sp" app:autoSizeMaxTextSize="128sp" app:autoSizeStepGranularity="1sp"
                    app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/welcomeAnti"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="40dp" android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-medium" android:textSize="20sp" android:textColor="@color/welcome_paper"
                    android:text="@string/welcome_caption" android:lineSpacingExtra="2dp"
                    app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/welcomeGym" app:layout_constraintBottom_toBottomOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.button.MaterialButton android:id="@+id/buttonLogin"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="72dp" android:padding="20dp"
                android:insetTop="0dp" android:insetBottom="0dp"
                android:text="@string/login" android:textSize="20sp" android:textAllCaps="false"
                android:fontFamily="sans-serif-medium" android:gravity="start|center_vertical"
                android:textColor="@color/welcome_ink" app:backgroundTint="@color/welcome_paper"
                app:cornerRadius="0dp" app:icon="@drawable/welcome_arrow" app:iconTint="@color/welcome_ink"
                app:iconGravity="end" app:iconSize="28dp" app:rippleColor="@color/welcome_muted"/>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="16dp"
                android:background="@color/welcome_rule" android:importantForAccessibility="no"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/buttonSignup"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="64dp" android:paddingStart="0dp" android:paddingEnd="0dp"
                android:text="@string/create_account" android:textSize="16sp" android:textAllCaps="false"
                android:gravity="end|center_vertical" android:textColor="@color/welcome_lime"
                app:cornerRadius="0dp" app:rippleColor="@color/welcome_rule"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
                android:text="@string/welcome_note" android:textAppearance="@style/WelcomeMicro"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
