<?xml version="1.0" ?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/app_background" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <ImageView android:id="@+id/buttonBack" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/baseline_arrow_back_24" android:tint="@color/app_text_secondary" android:contentDescription="@string/logout" android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true"/>
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="GymNotes" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/app_text_primary"/>
            <LinearLayout android:id="@+id/profileContainer" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:background="@drawable/bg_home_card" android:foreground="?attr/selectableItemBackground" android:contentDescription="@string/profile" android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:importantForAccessibility="no" android:src="@drawable/ic_profile_person" android:tint="@color/app_accent"/>
            </LinearLayout>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_kicker" android:textSize="11sp" android:textColor="@color/app_text_primary" android:layout_marginTop="8dp" android:letterSpacing="0.12" android:paddingTop="24dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_title_new" android:textSize="32sp" android:textColor="@color/app_text_primary" android:layout_marginTop="8dp" android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_subtitle_new" android:textSize="16sp" android:textColor="@color/app_text_secondary" android:layout_marginTop="8dp"/>
        <FrameLayout android:id="@+id/cardWorkouts" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:background="@drawable/bg_home_hero" android:foreground="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="24dp" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/workouts" android:textSize="26sp" android:textColor="#FFFFFF" android:layout_marginTop="8dp" android:tag="keep_text_color" android:textStyle="bold"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_workout_hint" android:textSize="15sp" android:textColor="#D1E4DF" android:layout_marginTop="8dp" android:tag="keep_text_color"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_workout_action" android:textSize="16sp" android:textColor="#C5F277" android:layout_marginTop="8dp" android:tag="keep_text_color" android:paddingTop="24dp" android:paddingBottom="8dp" android:textStyle="bold"/>
            </LinearLayout>
        </FrameLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_section" android:textSize="20sp" android:textColor="@color/app_text_primary" android:layout_marginTop="8dp" android:paddingTop="24dp" android:paddingBottom="8dp" android:textStyle="bold"/>
        <LinearLayout android:id="@+id/cardProgress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_home_card" android:foreground="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="20dp">
                <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/progress_icon" android:tint="@color/app_accent" android:importantForAccessibility="no"/>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="16dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/progress" android:textSize="18sp" android:textColor="@color/app_text_primary" android:layout_marginTop="8dp" android:textStyle="bold"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_detail_0" android:textSize="14sp" android:textColor="@color/app_text_secondary" android:layout_marginTop="8dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/cardNotes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_home_card" android:foreground="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="20dp">
                <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/notes" android:tint="@color/app_accent" android:importantForAccessibility="no"/>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="16dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/notes" android:textSize="18sp" android:textColor="@color/app_text_primary" android:layout_marginTop="8dp" android:textStyle="bold"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_detail_1" android:textSize="14sp" android:textColor="@color/app_text_secondary" android:layout_marginTop="8dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <FrameLayout android:id="@+id/cardGyms" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_home_card" android:foreground="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="20dp">
                <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_profile_person" android:tint="@color/app_accent" android:importantForAccessibility="no"/>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="16dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/gyms_nearby" android:textSize="18sp" android:textColor="@color/app_text_primary" android:layout_marginTop="8dp" android:textStyle="bold"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_detail_2" android:textSize="14sp" android:textColor="@color/app_text_secondary" android:layout_marginTop="8dp"/>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
        <LinearLayout android:id="@+id/cardNews" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_home_card" android:foreground="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="20dp">
                <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/news" android:tint="@color/app_accent" android:importantForAccessibility="no"/>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="16dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/news" android:textSize="18sp" android:textColor="@color/app_text_primary" android:layout_marginTop="8dp" android:textStyle="bold"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_detail_3" android:textSize="14sp" android:textColor="@color/app_text_secondary" android:layout_marginTop="8dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/cardSettings" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_home_card" android:foreground="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="20dp">
                <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/settings" android:tint="@color/app_accent" android:importantForAccessibility="no"/>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="16dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings" android:textSize="18sp" android:textColor="@color/app_text_primary" android:layout_marginTop="8dp" android:textStyle="bold"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_detail_4" android:textSize="14sp" android:textColor="@color/app_text_secondary" android:layout_marginTop="8dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
